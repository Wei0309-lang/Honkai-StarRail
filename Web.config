<configuration>
  <connectionStrings>
    <add name="HonkaiConnectionString" connectionString="Data Source=.;Initial Catalog=Honkai;Integrated Security=True;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
    <add name="HonkaiConnectionString2" connectionString="Data Source=.;Initial Catalog=Honkai;Integrated Security=True;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
  </system.web>
</configuration>