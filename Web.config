<?xml version="1.0" encoding="utf-8"?>
<!--
  如需如何設定 ASP.NET 應用程式的詳細資訊，請前往
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <connectionStrings>
    
    
    <add name="HonkaiStarConnectionString" connectionString="Data Source=(local);Initial Catalog=HonkaiStar;Integrated Security=True;TrustServerCertificate=True"
      providerName="System.Data.SqlClient" />
   
  </connectionStrings>
  <system.web>
	  
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
  </system.web>
	<system.webServer>
		<staticContent>
			<mimeMap fileExtension=".webp" mimeType="image/webp" />
		</staticContent>
	</system.webServer>
</configuration>


